{
  "name": "crewboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "ui": "vite client",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "test:browser": "playwright test",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "demo": "node server/demo.js",
    "load": "node tests/load.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vite": "7.3.7"
  }
}
